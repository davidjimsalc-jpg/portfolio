  type Language = keyof typeof translations;
  const storageKey = "cyber-portfolio-language";
  const toggle = document.querySelector<HTMLButtonElement>(".language-toggle");
  const flag = toggle?.querySelector<HTMLElement>(".language-toggle-flag");

  const getLanguage = (): Language => {
    const savedLanguage = localStorage.getItem(storageKey);
    return savedLanguage === "es" ? "es" : "en";
  };

  const applyLanguage = (language: Language) => {
    const dictionary = translations[language];
    document.documentElement.lang = language;

    document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((element) => {
      const key = element.dataset.i18n;

      if (key && key in dictionary) {
        element.textContent = dictionary[key as keyof typeof dictionary];
      }
    });

    document
      .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[data-i18n-placeholder]")
      .forEach((element) => {
        const key = element.dataset.i18nPlaceholder;

        if (key && key in dictionary) {
          element.placeholder = dictionary[key as keyof typeof dictionary];
        }
      });

    if (flag && toggle) {
      flag.classList.toggle("is-spain", language === "es");
      flag.classList.toggle("is-uk", language !== "es");
      toggle.setAttribute(
        "aria-label",
        language === "es" ? "Cambiar a ingles" : "Switch to Spanish",
      );
      toggle.title = language === "es" ? "Cambiar a ingles" : "Switch to Spanish";
    }
  };

  applyLanguage(getLanguage());

  toggle?.addEventListener("click", () => {
    const nextLanguage = getLanguage() === "es" ? "en" : "es";
    localStorage.setItem(storageKey, nextLanguage);
    applyLanguage(nextLanguage);
  });
</script>
