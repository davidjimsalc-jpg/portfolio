---

<section class="tool-marquee" aria-label="Tools and technologies">
  <div class="tool-marquee-track">
    {[...toolLogos, ...toolLogos].map((logo, index) => (
      <span class="tool-marquee-item">
        <img
          src={`/logos/${encodeURIComponent(logo)}`}
          alt={`Logo ${index + 1}`}
          loading="lazy"
        />
      </span>
    ))}
  </div>
</section>
